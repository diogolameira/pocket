# MongoDB connection string (without a database path — set MONGODB_DB instead)
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name
MONGODB_DB=expenses
# Port the HTTP server listens on
PORT=3000
# Extra browser origins allowed to call the API (comma-separated).
# Any localhost origin is always allowed, so this is only needed for others.
CORS_ORIGIN=http://localhost:5173

# Statement import (POST /api/import/parse). Optional — the rest of the API
# works without it; that endpoint returns a clear 503 until this is set.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cheap, fast model — extraction doesn't need a frontier model. Pinned to a
# concrete model rather than a "-latest" alias: Google throttles older/aliased
# models for newer API keys (503 "high demand"); new projects should use the
# current Flash-Lite tier.
GEMINI_MODEL=gemini-3.5-flash-lite
