# MongoDB connection string (without a database path — set MONGODB_DB instead)
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name
MONGODB_DB=expenses
# Port the HTTP server listens on
PORT=3000
# Extra browser origins allowed to call the API (comma-separated).
# Any localhost origin is always allowed, so this is only needed for others.
CORS_ORIGIN=http://localhost:5173
